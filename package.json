{
  "name": "plyr",
  "version": "3.8.5",
  "description": "Deprecated; security updates only. Use Video.js 10 for new projects (https://videojs.org). A simple, accessible and customizable HTML5, YouTube and Vimeo media player.",
  "keywords": [
    "DASH",
    "HLS",
    "HTML5 Audio",
    "HTML5 Video",
    "Media Player",
    "Shaka",
    "Video.js",
    "WordPress",
    "videojs"
  ],
  "homepage": "https://plyr.io",
  "bugs": {
    "url": "https://github.com/sampotts/plyr/issues"
  },
  "license": "MIT",
  "author": "Sam Potts <sam@potts.es>",
  "repository": {
    "type": "git",
    "url": "git://github.com/sampotts/plyr.git"
  },
  "style": "./dist/plyr.css",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/js/plyr.d.ts",
      "import": "./dist/plyr.mjs",
      "require": "./dist/plyr.js",
      "browser": "./dist/plyr.min.js",
      "default": "./dist/plyr.js"
    },
    "./dist/plyr.css": {
      "types": "./src/css.d.ts",
      "default": "./dist/plyr.css"
    },
    "./css": {
      "types": "./src/css.d.ts",
      "default": "./dist/plyr.css"
    },
    "./plyr.scss": "./src/sass/plyr.scss"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "vp config --no-agent",
    "dev": "pnpm --filter plyr-site dev",
    "start": "pnpm --filter plyr-site dev",
    "build": "pnpm build:player && pnpm build:site",
    "build:player": "node tasks/build.ts",
    "build:site": "pnpm --filter plyr-site build",
    "preview": "pnpm --filter plyr-site preview",
    "typecheck": "tsc --noEmit && pnpm --filter plyr-site typecheck",
    "lint": "vp lint && pnpm lint:css && pnpm remark",
    "lint:fix": "vp lint --fix && pnpm lint:css --fix",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "remark": "remark --use 'validate-links=repository:\"sampotts/plyr\"' \"*.md\"",
    "spellcheck": "cspell \"**/*.{js,ts,tsx,md,scss,css,json}\" --no-must-find-files",
    "deploy": "pnpm build:player && node tasks/deploy.ts"
  },
  "dependencies": {
    "custom-event-polyfill": "^1.0.7",
    "loadjs": "^4.3.0",
    "rangetouch": "^2.0.1",
    "url-polyfill": "^1.1.14"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@types/node": "^24.19.2",
    "autoprefixer": "^10.6.1",
    "cspell": "^10.4.0",
    "cssnano": "9.9.0",
    "dotenv": "^18.0.8",
    "mime": "^4.1.1",
    "postcss": "^8.5.31",
    "postcss-custom-properties": "^15.0.4",
    "postcss-scss": "^4.0.9",
    "remark-cli": "^12.0.1",
    "remark-validate-links": "^13.1.0",
    "sass": "1.105.2",
    "stylelint": "^17.16.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-selector-bem-pattern": "^5.0.0",
    "svgo": "^4.1.0",
    "svgstore": "^3.0.1",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "last 2 Opera versions"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@12.4.2",
  "sass": "./src/sass/plyr.scss"
}
